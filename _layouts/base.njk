---
layout: body.njk
---
{%- set slugs = page.url.split('/') -%}
{%- set slug = slugs[1].replace('.html', '') -%}
<div id="content" class="xcontainer m-4">
  <div class="row">
    {{ content | safe }}
    <div class="copyright">Copyright © {{
         '2018' if slug in ['1.3'] -}}
    {{- '2020' if slug in ['lwdita'] -}}
    {{- '2005–' ~ currentYear if slug in ['2.0']
      }} OASIS®</div>
  </div>
</div>
<script src="{{ site.baseurl }}/assets/js/main.js" type="text/javascript"></script>
