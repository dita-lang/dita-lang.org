---
layout: body.njk
---
<main class="cover {{ page.classes or '' }}">
  <div class="jumbotron jumbotron-fluid">
    <div class="container">
      <h1 class="display-3 ml-md-4 ml-lg-n2">{{ title }}</h1>
      <p class="lead">{{ lead }}</p>
      <p>{{ description }}</p>
    </div>
  </div>
  {{ content | safe }}
</main>
<script src="{{ site.baseurl }}/assets/js/cover.js" type="text/javascript"></script>
